{
  "name": "youtrack-issue-reminder",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode backend && vite build --mode workflows && vite build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf tw20_issue_reminder.zip && cd build && zip -r ../tw20_issue_reminder.zip .",
    "upload": "youtrack-workflow upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.23.4",
    "@jetbrains/ring-ui-built": "^7.0.124",
    "@jetbrains/youtrack-scripting": "^0.2.1",
    "@jetbrains/youtrack-scripting-api": "^2022.1.46592",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "tailwindcss": "^4.3.3",
    "usehooks-ts": "^3.1.0",
    "uuid": "^14.0.2",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
