{
  "name": "youtrack-issue-reminder",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode backend && vite build --mode workflows && vite build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf tw20_issue_reminder.zip && cd build && zip -r ../tw20_issue_reminder.zip .",
    "upload": "youtrack-workflow upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.22.0",
    "@jetbrains/ring-ui-built": "^7.0.120",
    "@jetbrains/youtrack-scripting": "^0.2.1",
    "@jetbrains/youtrack-scripting-api": "^2022.1.46592",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "usehooks-ts": "^3.1.0",
    "uuid": "^14.0.0",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
